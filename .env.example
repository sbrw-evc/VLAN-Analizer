# Exact browser origin, no trailing slash. HTTPS via your reverse proxy.
PUBLIC_URL=https://vlan.example.com
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Select host L3 interfaces; empty means all eligible interfaces.
# Prefer an explicit allowlist to avoid probing through Docker/veth interfaces.
INTERFACES=eno1.10,eno1.20
# Reachable DNS servers per interface. Do not use 127.0.0.53 for a VLAN-bound query.
VLAN_DNS={"eno1.10":["192.168.10.1"],"eno1.20":["192.168.20.1"]}
CHECK_INTERVAL=120
CHECK_CONCURRENCY=3
CHECK_TIMEOUT=20
STALE_AFTER=600
BROWSER_ENABLED=true
# Self-hosted Gatus API. URLs may be hidden; prefer GATUS_CONFIG in that case.
GATUS_URL=
GATUS_CONFIG=
# Optional Uptime Kuma 2.x MySQL/MariaDB import (SELECT-only monitor access).
KUMA_MYSQL_HOST=
KUMA_MYSQL_PORT=3306
KUMA_MYSQL_DATABASE=kuma
KUMA_MYSQL_USER=vlan_reader
# TLS requires a trusted certificate and matching DB hostname; no downgrade.
KUMA_MYSQL_TLS=true
# Mount a private CA read-only in app.volumes if required.
KUMA_MYSQL_CA=
# Stable namespace for this Kuma database; set before first import.
KUMA_INSTANCE_ID=default
# Password: OpenBao secret/vlan-analizer/app -> kuma_mysql_password
