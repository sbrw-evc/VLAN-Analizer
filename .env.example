# Production image from GitHub Container Registry; pin a version for repeatable upgrades.
VLAN_ANALIZER_VERSION=latest
# Network/scan settings. Connections and credentials are configured in the UI.
INTERFACES=eno1.10,eno1.20
VLAN_DNS={"eno1.10":["192.168.10.1"],"eno1.20":["192.168.20.1"]}
CHECK_INTERVAL=120
CHECK_CONCURRENCY=3
CHECK_TIMEOUT=20
STALE_AFTER=600
BROWSER_ENABLED=true
